# Together.ai API Key - get yours at https://api.together.xyz
TOGETHER_API_KEY=your_together_api_key_here

# Kafka (set KAFKA_ENABLED=false to run without Docker/Kafka)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=cv_chunks
ANONYMIZED_TELEMETRY=false

# Together.ai models
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Audit log
AUDIT_LOG_PATH=./data/audit.jsonl

# API
API_HOST=0.0.0.0
API_PORT=8000

# Paths to YAML configs
RBAC_POLICY_PATH=config/rbac_policies.yaml
INFO_MODEL_PATH=config/information_model.yaml

# Watched directory for file watcher
CV_WATCH_DIR=./data/incoming_cvs
